#!/usr/bin/env bash

export NVIM_APPNAME="lvim"

export XDG_CONFIG_HOME="$HOME/.lunarvim/.config"
export XDG_DATA_HOME="$HOME/.lunarvim/.local/share"
export XDG_RUNTIME_DIR="$HOME/.lunarvim/.local/share/lazynv"
export XDG_STATE_HOME="${XDG_STATE_HOME:-"$HOME/.lunarvim/.local/state"}"
export XDG_CACHE_HOME="$HOME/.lunarvim/.cache"

export LUNARVIM_RUNTIME_DIR="$HOME/.lunarvim/.local/share/lunarvim"
export LUNARVIM_CONFIG_DIR="$HOME/.lunarvim/.config/lvim"
export LUNARVIM_CACHE_DIR="$HOME/.lunarvim/.cache/lvim"
export LUNARVIM_BASE_DIR="$HOME/.lunarvim/.local/share/lunarvim/lvim"

export LV_BRANCH='release-1.3/neovim-0.9'

if [ ! -e $LUNARVIM_BASE_DIR/init.lua ]; then
  # curl -sSL https://raw.githubusercontent.com/LunarVim/LunarVim/${LV_BRANCH}/utils/installer/install.sh | bash
  bash <(curl -s https://raw.githubusercontent.com/LunarVim/LunarVim/${LV_BRANCH}/utils/installer/install.sh)
fi

exec -a "$NVIM_APPNAME" nvim -u "$LUNARVIM_BASE_DIR/init.lua" "$@"
