[user]
    email = suglow006@gmail.com
    name = suglow006
[core]
    safecrlf = true
    autocrlf = false
    editor = nv
[color]
    ui = auto

[pager]
    diff = delta
    log = delta
    reflog = delta
    show = delta

[interactive]
    diffFilter = delta --color-only --features=interactive

[delta]
    features = decorations
    side-by-side = true
    line-numbers-left-format = ""
    line-numbers-right-format = "│ "

[delta "interactive"]
    keep-plus-minus-markers = false

[delta "decorations"]
    commit-decoration-style = blue ol
    commit-style = raw
    file-style = omit
    hunk-header-decoration-style = blue box
    hunk-header-file-style = red
    hunk-header-line-number-style = "#067a00"
    hunk-header-style = file line-number syntax
[merge]
    tool = "diffview"
[mergetool]
    prompt = false
    keepBackup = false
[diff]
    tool = vimdiff
[init]
    defaultBranch = main
[mergetool "vimdiff"]
    path = nvim
[mergetool "nvim"]
    cmd = "nv -d -c \"wincmd l\" -c \"norm ]c\" \"$LOCAL\" \"$MERGED\" \"$REMOTE\""
[mergetool "diffview"]
    cmd = nvim -n -c "DiffviewOpen" "$MERGE"
    
[alias]
    l = log --oneline --decorate --graph --all
