#!/usr/bin/env bash

declare -xr NVIM_APPNAME="nvchad"

export XDG_CONFIG_HOME="$HOME/.nvchad/.config"
export XDG_DATA_HOME="$HOME/.nvchad/.local/share"
export XDG_RUNTIME_DIR="$HOME/.nvchad/.local/share/nvchad"
export XDG_STATE_HOME="${XDG_STATE_HOME:-"$HOME/.nvchad/.local/state"}"
export XDG_CACHE_HOME="$HOME/.nvchad/.cache"
export MYVIMRC="$XDG_CONFIG_HOME/$NVIM_APPNAME/init.lua"

declare -xr NVCHAD_BRANCH='v2.0'
declare -xr NVCHAD_REMOTE="NvChad/NvChad"

if [ ! -e $MYVIMRC ]; then
	echo "Cloning NvChad Config"
	if ! git clone --branch "$NVCHAD_BRANCH" \
		"https://github.com/${NVCHAD_REMOTE}" "$XDG_CONFIG_HOME/$NVIM_APPNAME"; then
		echo "Failed to clone repository. Installation failed."
		exit 1
	fi
	echo "link to custom"
	SCRIPT_PATH=$(readlink -f "$0")
	SCRIPT_DIR=$(dirname "$SCRIPT_PATH")
	CUSTOM_DIR=$(readlink -f "$SCRIPT_DIR/../../.nvchad/custom")
	ln -s "$SCRIPT_DIR/../../custom" "$XDG_CONFIG_HOME/$NVIM_APPNAME/lua"

	nc --headless -c 'quitall'
	echo "Lazy setup complete"
fi

exec -a "$NVIM_APPNAME" nvim -u "$MYVIMRC" "$@"
